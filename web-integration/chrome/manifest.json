{
	"manifest_version": 3,
	"name": "Quantum Web Integration",
	"version": "1.1.0",
	"description": "The web integration for Quantum download manager.",
	"author": "Mouloud Guenane",
	"icons": {
		"16": "assets/icon-16.png",
		"32": "assets/icon-32.png",
		"48": "assets/icon-48.png",
		"128": "assets/icon-128.png"
	},
	"action": {
		"default_title": "Quantum Integration",
		"default_popup": "popup/popup.html",
		"default_icon": {
			"16": "assets/icon-16.png",
			"32": "assets/icon-32.png",
			"48": "assets/icon-48.png",
			"128": "assets/icon-128.png"
		}
	},
	"background": {
		"service_worker": "background.js",
		"type": "module"
	},
	"options_page": "options/options.html",
	"permissions": [
		"downloads",
		"storage"
	],
	"optional_permissions": [],
	"host_permissions": [
		"http://127.0.0.1:8421/*"
	],
	"content_scripts": [
		{
			"matches": [
				"https://*/*",
				"http://*/*"
			],
			"js": ["content.js"],
			"css": ["content.css"],
			"run_at": "document_idle"
		}
	],
	"web_accessible_resources": [
		{
			"resources": ["assets/*"],
			"matches": [
				"https://*/*",
				"http://*/*"
			]
		}
	],
	"commands": {
		"toggle-extension": {
			"suggested_key": {
				"default": "Ctrl+Shift+Q",
				"mac": "Command+Shift+Q"
			},
			"description": "Toggle the extension"
		}
	},
	"content_security_policy": {
		"extension_pages": "script-src 'self'; object-src 'self'"
	}
}
